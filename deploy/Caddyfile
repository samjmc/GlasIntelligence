# Caddy gets and renews the Let's Encrypt certificate for APP_DOMAIN by itself.
# The DNS record for APP_DOMAIN must point at this server (Cloudflare: "DNS only",
# grey cloud) before the first start; see docs/hosting.md.
{
	email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	reverse_proxy app:80 {
		transport http {
			read_timeout 600s
			write_timeout 600s
		}
	}
}
