# Caddy gets and renews the Let's Encrypt certificate for APP_DOMAIN by itself.
# The DNS record for APP_DOMAIN must point at this server (Cloudflare: "DNS only",
# grey cloud) before the first start; see docs/hosting.md.
{
	email {$ACME_EMAIL}

	# Data minimisation: Caddy's error log lines keep the path and method only.
	# Query strings (tokens), request headers and client IPs are removed.
	log {
		format filter {
			wrap json
			request>uri regexp \?.* ""
			request>headers delete
			request>remote_ip delete
			request>client_ip delete
			request>remote_port delete
		}
	}
}

{$APP_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	reverse_proxy app:80 {
		transport http {
			read_timeout 600s
			write_timeout 600s
		}
	}
}

# Other apps on this host (GlasApp) put one site block per file in deploy/sites/ on
# the server. The files are not in git. A glob that matches no file is fine.
import /etc/caddy/sites/*.caddy
