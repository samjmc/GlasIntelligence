# Minimal environment for the Task 3 golden recording.
#
# This is NOT the full application config. It is the subset that an actual
# end-to-end recording exercises, determined empirically by booting the app
# with an empty environment and reading what it demanded. Stripe, Resend,
# Sentry and PostHog are deliberately absent — a recording never reaches them.
#
# Usage:
#   cp .env.demo-record.example .env
#   # fill in the six SECRET values below
#
# .env is covered by .gitignore:20, so it will not follow this branch into
# the public repo. Verify with: git check-ignore -v .env

# ---------------------------------------------------------------------------
# Prefilled — safe to commit, these are public by design
# ---------------------------------------------------------------------------
SUPABASE_URL=https://ihecemdupqnxltdyebsh.supabase.co
SUPABASE_ANON_KEY=sb_publishable_UVZtRtshL2q2UCYa1vb-0A_0HIGhkCt
VITE_SUPABASE_URL=https://ihecemdupqnxltdyebsh.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_UVZtRtshL2q2UCYa1vb-0A_0HIGhkCt

# Local broker started by scripts/demo-record-stack.sh (no Docker needed).
REDIS_URL=redis://localhost:6379/0

FLASK_DEBUG=0
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# SECRETS — you must supply these. They are not retrievable from any MCP.
# ---------------------------------------------------------------------------

# Flask session signing. Any long random string; `openssl rand -hex 32`.
SECRET_KEY=

# Supabase service_role key + JWT secret.
# Dashboard -> Project Settings -> API. NOT exposed by the Supabase MCP,
# which only returns publishable keys.
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=

# The three paid vendors the run actually calls. These cost real money per run.
#
# Deep research runs on the Claude chain: Tavily live search + an iterative
# Claude prompt loop (query gen -> search -> synthesis -> critique with
# follow-ups -> verification). No OpenAI key is needed — LLM_API_KEY is a DeepSeek key (platform.deepseek.com).
LLM_API_KEY=
TAVILY_API_KEY=
ZEP_API_KEY=

# ---------------------------------------------------------------------------
# Model routing — copy whatever you normally run, these affect the recording's
# content and therefore what a recruiter sees.
# ---------------------------------------------------------------------------
# Ignored when LLM_API_KEY is an Anthropic key (LLMClient routes to the
# Anthropic SDK); kept for OpenAI-compatible providers.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_NAME=deepseek-v4-flash

# OpenAI deep research is OFF for the golden run — the Claude chain is faster
# and cheaper at ~90% of the quality. Set to true only if you have an OpenAI
# key and want the premium path (30-45 min, billed per minute).
DEEP_RESEARCH_ENABLED=false

# Claude search-research chain knobs.
SEARCH_RESEARCH_MODEL=deepseek-v4-flash
SEARCH_RESEARCH_MAX_ROUNDS=3
SEARCH_RESEARCH_QUALITY_THRESHOLD=7.5
