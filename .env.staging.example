# Staging environment — copy to .env.staging and fill in values
# Uses the same structure as .env.example but with staging-specific values

SECRET_KEY=change-me-staging
FLASK_DEBUG=False

LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_NAME=deepseek-chat

DEEP_RESEARCH_ENABLED=false

ENABLE_REPORT_PAYLOAD_V1=true
ENABLE_GROUNDING_FEATURES=true
ENABLE_DECISION_LAYER=false

ZEP_API_KEY=

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_ANON_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@glasinsight.com

REDIS_URL=redis://staging-redis:6379/0

FRONTEND_URL=https://staging.glasinsight.com
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

CORS_ORIGINS=https://staging.glasinsight.com
