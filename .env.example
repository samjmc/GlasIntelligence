# Flask
SECRET_KEY=change-me-in-production
FLASK_DEBUG=False

# LLM
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
# deepseek-flash = DeepSeek-V4.1-Flash (2026-09-10). deepseek-chat is no longer listed by the
# API; the legacy name deepseek-v4-flash is still accepted and served by V4.1-Flash.
LLM_MODEL_NAME=deepseek-flash

# Deep Research (OpenAI Responses API — uses LLM_API_KEY)
DEEP_RESEARCH_ENABLED=false
DEEP_RESEARCH_MODEL=o4-mini-deep-research
DEEP_RESEARCH_MAX_TOOL_CALLS=50

# Feature flags
ENABLE_REPORT_PAYLOAD_V1=true
ENABLE_GROUNDING_FEATURES=true
ENABLE_DECISION_LAYER=false

# Grounding staleness policy
GROUNDING_MAX_AGE_HOURS=168
GROUNDING_BLOCK_IF_STALE=false
GROUNDING_WARN_IF_STALE=true
ENABLE_WEB_ENRICHER=false

# Jev (TypeSafe System One) — typed decisions with calibrated confidence.
# Optional fast path for agent tool roles, stance classification and risk scoring;
# leave JEV_ENABLED=false to keep the pure-LLM behaviour.
# JEV_PROVIDER: typesafe (key from typesafe.ai) | cloudflare (Workers AI token +
# CLOUDFLARE_ACCOUNT_ID) | vercel (AI Gateway key). JEV_API_KEY is that provider's key.
JEV_ENABLED=false
JEV_PROVIDER=cloudflare
JEV_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
JEV_MIN_CONFIDENCE=0.6
# JEV_MODE: off | shadow | active. shadow runs Jev alongside the LLM on every gate, records
# agreement and cost in the metrics ledger, but keeps the LLM's answer - the safe way to
# measure a new gate first. JEV_ENABLED=true is an alias for active.
JEV_MODE=off
# Comma-separated gate names to force back to the LLM while the rest stay on JEV_MODE, e.g.
# JEV_DISABLED_SITES=tool_roles,research_verify   (names: see docs/jev-evaluation.md)
JEV_DISABLED_SITES=
# Parallel Jev calls. Cloudflare rate-limits bursts; 4 is safe, 8 sees occasional retries.
JEV_MAX_WORKERS=4

# Knowledge graph: zep (Zep Cloud, metered) or graphiti (self-hosted Neo4j, no credits).
GRAPH_BACKEND=zep

# Zep Cloud (GRAPH_BACKEND=zep)
ZEP_API_KEY=

# Graphiti on Neo4j (GRAPH_BACKEND=graphiti). Extraction uses the LLM_* settings above.
# Keep NEO4J_PASSWORD in a user-level environment variable, not in this file.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# Optional: a different model for extraction only (default: LLM_MODEL_NAME).
GRAPHITI_LLM_MODEL=
# Local embedder (about 130 MB on first use). Changing it on an existing database is refused.
GRAPHITI_EMBED_MODEL=BAAI/bge-small-en-v1.5
GRAPHITI_EMBED_DIM=384
GRAPHITI_MAX_COROUTINES=5
GRAPHITI_CHUNK_SIZE=2000
GRAPHITI_CHUNK_OVERLAP=100
GRAPHITI_EPISODE_TIMEOUT_SEC=300

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_ANON_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PAYG=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_PACK_5=
STRIPE_PRICE_PACK_10=
STRIPE_PRICE_OVERAGE_PRO=
STRIPE_PRICE_OVERAGE_BUSINESS=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@glasinsight.com

# Redis
REDIS_URL=redis://localhost:6379/0

# Frontend
FRONTEND_URL=https://glasinsight.com
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Analytics (PostHog)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Security
CORS_ORIGINS=https://glasinsight.com,https://www.glasinsight.com

# Admin
ADMIN_USER_IDS=

# Observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_RATE=0.1
ENABLE_PROMETHEUS=false
