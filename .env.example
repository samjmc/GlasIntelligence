# Flask
SECRET_KEY=change-me-in-production
FLASK_DEBUG=False

# LLM
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_NAME=deepseek-chat

# Deep Research (OpenAI Responses API — uses LLM_API_KEY)
DEEP_RESEARCH_ENABLED=false
DEEP_RESEARCH_MODEL=o4-mini-deep-research
DEEP_RESEARCH_MAX_TOOL_CALLS=50

# Feature flags
ENABLE_REPORT_PAYLOAD_V1=true
ENABLE_GROUNDING_FEATURES=true
ENABLE_DECISION_LAYER=false
ENABLE_AGENT_TOOLS=true
AGENT_TOOLS_MAX_ITERATIONS=3

# Grounding staleness policy
GROUNDING_MAX_AGE_HOURS=168
GROUNDING_BLOCK_IF_STALE=false
GROUNDING_WARN_IF_STALE=true
ENABLE_WEB_ENRICHER=false

# Zep Cloud
ZEP_API_KEY=

# Zep graph memory batching (simulation → Zep graph.add; see docs/zep-footprint.md)
ZEP_GRAPH_MEMORY_BATCH_SIZE=5
ZEP_GRAPH_MEMORY_SEND_INTERVAL_SEC=0.5

# Graph snapshot cache (fewer Zep list API calls; see docs/graph-cache.md)
GRAPH_SNAPSHOT_CACHE_ENABLED=1
GRAPH_SNAPSHOT_TTL_SECONDS=86400
GRAPH_SNAPSHOT_STALE_MAX_AGE_SECONDS=604800
GRAPH_SNAPSHOT_MAX_DISK_MB=512
GRAPH_SNAPSHOT_SINGLEFLIGHT=1

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_ANON_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PAYG=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_PACK_5=
STRIPE_PRICE_PACK_10=
STRIPE_PRICE_OVERAGE_PRO=
STRIPE_PRICE_OVERAGE_BUSINESS=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@glasinsight.com

# Redis
REDIS_URL=redis://localhost:6379/0

# Frontend
FRONTEND_URL=https://glasinsight.com
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Low-Zep footprint (Vite build-time; rebuild frontend image after change — docs/zep-footprint.md)
# VITE_ZEP_GRAPH_POLL_VISIBLE_MS=120000
# VITE_ZEP_GRAPH_POLL_HIDDEN_MS=300000
# VITE_ZEP_GRAPH_POLL_DURING_BUILD_MS=8000
# VITE_ZEP_GRAPH_POLL_WHILE_SIMULATING_MS=0
# VITE_ZEP_GRAPH_SKIP_WHEN_HIDDEN=true
# VITE_ZEP_STEP2_POLL_MS_INITIAL=2000
# VITE_ZEP_STEP2_POLL_MS_DECAY=5000
# VITE_ZEP_STEP3_STATUS_MS=4000
# VITE_ZEP_STEP3_DETAIL_MS=6000

# Analytics (PostHog)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Security
CORS_ORIGINS=https://glasinsight.com,https://www.glasinsight.com

# Admin
ADMIN_USER_IDS=

# Observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_RATE=0.1
ENABLE_PROMETHEUS=false
