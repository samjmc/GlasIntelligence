# Flask
SECRET_KEY=change-me-in-production
FLASK_DEBUG=False

# LLM
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_NAME=deepseek-chat

# Deep Research (OpenAI Responses API — uses LLM_API_KEY)
DEEP_RESEARCH_ENABLED=false
DEEP_RESEARCH_MODEL=o4-mini-deep-research
DEEP_RESEARCH_MAX_TOOL_CALLS=50

# Feature flags
ENABLE_REPORT_PAYLOAD_V1=true
ENABLE_GROUNDING_FEATURES=true
ENABLE_DECISION_LAYER=false

# Grounding staleness policy
GROUNDING_MAX_AGE_HOURS=168
GROUNDING_BLOCK_IF_STALE=false
GROUNDING_WARN_IF_STALE=true
ENABLE_WEB_ENRICHER=false

# Zep Cloud
ZEP_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_ANON_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PAYG=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_PACK_5=
STRIPE_PRICE_PACK_10=
STRIPE_PRICE_OVERAGE_PRO=
STRIPE_PRICE_OVERAGE_BUSINESS=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@glasinsight.com

# Redis
REDIS_URL=redis://localhost:6379/0

# Frontend
FRONTEND_URL=https://glasinsight.com
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Analytics (PostHog)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Security
CORS_ORIGINS=https://glasinsight.com,https://www.glasinsight.com

# Admin
ADMIN_USER_IDS=

# Observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_RATE=0.1
ENABLE_PROMETHEUS=false
