FROM node:20-slim AS frontend-build
WORKDIR /build
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./

ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_ZEP_GRAPH_POLL_VISIBLE_MS
ARG VITE_ZEP_GRAPH_POLL_HIDDEN_MS
ARG VITE_ZEP_GRAPH_POLL_DURING_BUILD_MS
ARG VITE_ZEP_GRAPH_POLL_WHILE_SIMULATING_MS
ARG VITE_ZEP_GRAPH_SKIP_WHEN_HIDDEN
ARG VITE_ZEP_STEP2_POLL_MS_INITIAL
ARG VITE_ZEP_STEP2_POLL_MS_DECAY
ARG VITE_ZEP_STEP3_STATUS_MS
ARG VITE_ZEP_STEP3_DETAIL_MS
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY
ENV VITE_ZEP_GRAPH_POLL_VISIBLE_MS=$VITE_ZEP_GRAPH_POLL_VISIBLE_MS
ENV VITE_ZEP_GRAPH_POLL_HIDDEN_MS=$VITE_ZEP_GRAPH_POLL_HIDDEN_MS
ENV VITE_ZEP_GRAPH_POLL_DURING_BUILD_MS=$VITE_ZEP_GRAPH_POLL_DURING_BUILD_MS
ENV VITE_ZEP_GRAPH_POLL_WHILE_SIMULATING_MS=$VITE_ZEP_GRAPH_POLL_WHILE_SIMULATING_MS
ENV VITE_ZEP_GRAPH_SKIP_WHEN_HIDDEN=$VITE_ZEP_GRAPH_SKIP_WHEN_HIDDEN
ENV VITE_ZEP_STEP2_POLL_MS_INITIAL=$VITE_ZEP_STEP2_POLL_MS_INITIAL
ENV VITE_ZEP_STEP2_POLL_MS_DECAY=$VITE_ZEP_STEP2_POLL_MS_DECAY
ENV VITE_ZEP_STEP3_STATUS_MS=$VITE_ZEP_STEP3_STATUS_MS
ENV VITE_ZEP_STEP3_DETAIL_MS=$VITE_ZEP_STEP3_DETAIL_MS

RUN npm run build

FROM python:3.11-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends nginx curl \
  && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.9.26 /uv /uvx /bin/

WORKDIR /app

COPY backend/pyproject.toml backend/uv.lock ./backend/
RUN cd backend && uv sync --frozen \
  && .venv/bin/pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
  && rm -rf /root/.cache

COPY backend/ ./backend/
COPY --from=frontend-build /build/dist ./frontend/dist
RUN rm -f /etc/nginx/sites-enabled/default /etc/nginx/sites-available/default
COPY nginx/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80 443 5001

CMD ["sh", "-c", "nginx && cd /app/backend && .venv/bin/gunicorn -w 1 --threads 4 -b 0.0.0.0:5001 --timeout 600 'app:create_app()'"]
